# Only the tools are published. Everything else in this folder (notes, build write-ups, assistant
# instructions) stays private, so this file lists what's allowed rather than what isn't.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE.md
!/NOTICE.md
!/tools/
# the drafted plans and their generators are creative work: they stay out of the public copy
/tools/drafts/

__pycache__/
*.pyc
_site/
